{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:create": "tsx src/db/create-database.ts",
    "db:bootstrap": "tsx src/db/bootstrap-role.ts",
    "admin:grant": "tsx src/db/grant-admin.ts",
    "seed:demo": "tsx src/db/seed-demo.ts",
    "seed:month": "tsx src/db/seed-month.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:verify": "tsx src/db/verify-isolation.ts && tsx src/db/verify-constraints.ts",
    "db:clean-test": "tsx src/db/clean-test-data.ts",
    "verify:auth": "tsx src/http/verify-auth.ts",
    "verify:api": "tsx src/http/verify-api.ts",
    "verify:telegram": "tsx src/http/verify-telegram.ts",
    "verify:pipeline": "tsx src/http/verify-pipeline.ts",
    "verify:dashboard": "tsx src/http/verify-dashboard.ts",
    "verify:billing-logic": "tsx src/billing/verify-engine.ts",
    "verify:billing": "tsx src/http/verify-billing.ts",
    "verify:playbook-ai": "tsx src/http/verify-playbook-ai.ts",
    "verify:reports": "tsx src/http/verify-reports.ts",
    "verify:coaching": "tsx src/http/verify-coaching.ts",
    "verify:auth-cache": "tsx src/auth/verify-context-cache.ts",
    "bench": "tsx src/http/bench.ts",
    "verify:settings": "tsx src/business/verify-settings.ts",
    "verify:notify": "tsx src/jobs/verify-notify.ts",
    "verify:moizvonki": "tsx src/integrations/verify-moizvonki.ts",
    "verify:crm": "tsx src/integrations/verify-crm-export.ts",
    "verify:password-reset": "tsx src/http/verify-password-reset.ts",
    "verify:activation": "tsx src/http/verify-activation.ts",
    "verify:import": "tsx src/http/verify-import.ts",
    "verify:stt": "tsx src/http/verify-stt.ts",
    "verify": "npm run typecheck && npm run db:verify && npm run verify:auth && npm run verify:api && npm run verify:telegram && npm run verify:pipeline && npm run verify:dashboard && npm run verify:billing-logic && npm run verify:billing && npm run verify:playbook-ai && npm run verify:reports && npm run verify:coaching && npm run verify:password-reset && npm run verify:activation && npm run verify:import && npm run verify:stt",
    "provider:llm": "tsx src/db/add-llm-provider.ts",
    "provider:stt": "tsx src/db/add-stt-provider.ts",
    "stt:local": "python ../tools/whisper-local.py",
    "stt:gigaam": "python ../tools/gigaam-local.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^10.2.2",
    "@node-rs/argon2": "^2.0.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.1",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
