# ─────────────────────────────────────────────────────────────
# Nusxa oling:  cp .env.example .env    (yoki Windows: copy .env.example .env)
# .env hech qachon git ga tushmaydi.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ─── Baza: IKKITA ulanish ────────────────────────────────────────────────────
#
# MUHIM: PostgreSQL'da superuser Row Level Security ni HAR DOIM chetlab o'tadi.
# Shuning uchun ilova alohida, superuser bo'lmagan rol ostida ulanadi.
# Aks holda tenant izolyatsiyasi o'rnatilgandek ko'rinadi, lekin ishlamaydi.

# Egalik ulanishi: migratsiya, rol yaratish, super-admin. Superuser.
DATABASE_URL_ADMIN=postgresql://postgres:PAROL@localhost:5432/sotuv

# Ilova ulanishi. `npm run db:bootstrap` buni avtomatik to'ldiradi.
# Qo'lda tegmang.
DATABASE_URL=

# Sessiya cookie imzosi uchun. Kamida 32 belgi.
# Generatsiya: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COOKIE_SECRET=CHANGE_ME_min_32_belgi_tasodifiy_satr_bolishi_kerak

# Integratsiya kalitlarini shifrlash uchun (AES-256-GCM, 32 bayt base64).
# Generatsiya: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=

# Frontend manzili (CORS uchun)
WEB_ORIGIN=http://localhost:5173

# Backend'ning TASHQI manzili — Claude (MCP) ulanishi shundan quriladi: ${PUBLIC_URL}/mcp
# Lokal sinovda (Claude Code / Desktop) bo'sh qoldiring: http://localhost:PORT olinadi.
# claude.ai (brauzer, telefon) uchun ommaviy HTTPS shart, masalan: https://api.sotuv.uz
# PUBLIC_URL=

# ─── Meta Lead Ads: "Facebook orqali ulash" (ixtiyoriy) ──────────────────────
# Platformadagi BITTA Meta ilovasi. Qo'llanma: docs/meta-lead-ads.md
# Bo'sh qolsa server ishlayveradi, interfeysda "Integratsiya hali sozlanmagan".
# Haqiqiy qiymatlarni faqat serverdagi .env ga yozing — git'ga tushmasin.
#
# Meta App Dashboard → App settings → Basic → App ID / App secret
# META_APP_ID=
# META_APP_SECRET=
# Facebook Login for Business → Configurations → (User access token) → Configuration ID
# META_LOGIN_CONFIG_ID=
# Graph API versiyasi (bo'sh — META_GRAPH_VERSION yoki v23.0)
# META_GRAPH_API_VERSION=v24.0
# Bo'sh — ${PUBLIC_URL}/api/v1/crm/oauth/meta/callback. Meta'dagi "Valid OAuth Redirect URIs" bilan AYNAN bir xil.
# META_OAUTH_REDIRECT_URI=
# Webhooks → Page → Verify token (o'zingiz o'ylab topgan uzun tasodifiy satr, kamida 16 belgi)
# Generatsiya: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# META_WEBHOOK_VERIFY_TOKEN=
# Faqat META_LOGIN_CONFIG_ID bo'lmaganda: so'raladigan ruxsatlar (vergul bilan). Bo'sh — standart ro'yxat.
# META_OAUTH_SCOPES=
