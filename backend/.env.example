# ─────────────────────────────────────────────────────────────
# Nusxa oling:  cp .env.example .env    (yoki Windows: copy .env.example .env)
# .env hech qachon git ga tushmaydi.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ─── Baza: IKKITA ulanish ────────────────────────────────────────────────────
#
# MUHIM: PostgreSQL'da superuser Row Level Security ni HAR DOIM chetlab o'tadi.
# Shuning uchun ilova alohida, superuser bo'lmagan rol ostida ulanadi.
# Aks holda tenant izolyatsiyasi o'rnatilgandek ko'rinadi, lekin ishlamaydi.

# Egalik ulanishi: migratsiya, rol yaratish, super-admin. Superuser.
DATABASE_URL_ADMIN=postgresql://postgres:PAROL@localhost:5432/sotuv

# Ilova ulanishi. `npm run db:bootstrap` buni avtomatik to'ldiradi.
# Qo'lda tegmang.
DATABASE_URL=

# Sessiya cookie imzosi uchun. Kamida 32 belgi.
# Generatsiya: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COOKIE_SECRET=CHANGE_ME_min_32_belgi_tasodifiy_satr_bolishi_kerak

# Integratsiya kalitlarini shifrlash uchun (AES-256-GCM, 32 bayt base64).
# Generatsiya: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=

# Frontend manzili (CORS uchun)
WEB_ORIGIN=http://localhost:5173
