# ─────────────────────────────────────────────────────────────────────────────
# Serverdagi /opt/sotuv/.env namunasi. Nusxa: cp .env.example .env && nano .env
# Bu fayl HECH QACHON git'ga tushmaydi va chatga yuborilmaydi.
# Tasodifiy qiymat yaratish:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ─── Domen ───────────────────────────────────────────────────────────────────
# Domen bo'lsa — HTTPS avtomatik. Hali yo'q bo'lsa  :80  qoldiring.
SITE_ADDRESS=:80
WEB_ORIGIN=http://SERVER_IP
PUBLIC_URL=http://SERVER_IP

# ─── Baza ────────────────────────────────────────────────────────────────────
# Faqat harf/raqam (URL ichiga tushadi): openssl rand -hex 24
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# ─── Ilova sirlari ───────────────────────────────────────────────────────────
# COOKIE_SECRET — yangisi bo'lishi mumkin (foydalanuvchilar qayta kiradi).
COOKIE_SECRET=
# CREDENTIALS_KEY — LOKAL backend/.env dagi AYNAN O'SHA qiymat bo'lishi SHART.
# Aks holda bazadagi shifrlangan kalitlar (GLM, Moi Zvonki) ochilmaydi.
CREDENTIALS_KEY=

# ─── STT / modellar ──────────────────────────────────────────────────────────
HF_TOKEN=
# 12 yadro / 2 STT = 6 yadrodan
STT_CONCURRENCY=2
OMP_NUM_THREADS=6

# ─── Worker ──────────────────────────────────────────────────────────────────
# Z.ai bir vaqtdagi so'rov limitini bilgach oshiring (429 chiqsa — kamaytiring).
WORKER_CONCURRENCY=3
LOG_LEVEL=info
