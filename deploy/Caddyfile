# SITE_ADDRESS:
#   domen bo'lsa  →  sotuv.example.uz   (HTTPS avtomatik)
#   hali domen yo'q  →  :80              (faqat HTTP, IP orqali sinov uchun)
#
# SaaS mijoz kabinetlari (<slug>.<domen>):
#   - domensiz (:80): :80 bloki HAMMA xostni qabul qiladi, kabinetlar
#     http://<slug>.<IP>.sslip.io da ochiladi (backend/src/http/tenant.ts).
#   - domen bilan: pastdagi `https://` bloki istalgan subdomenga sertifikatni
#     birinchi so'rovda oladi (on-demand TLS). Sertifikat faqat backend
#     tasdiqlagan (mavjud kabinet) xostga beriladi — aks holda tasodifiy
#     subdomenlar Let's Encrypt limitini tugatardi.
#   DNS: domen uchun  A  @  →  IP  va  A  *  →  IP  (wildcard) yozuvlari kerak.

{
	on_demand_tls {
		ask http://backend:3000/api/v1/public/tls-check
	}
}

(ilova) {
	encode zstd gzip

	# Backend yo'llari. DIQQAT: `/mcp` faqat ANIQ yo'l — `/mcp/ruxsat`
	# frontend sahifasi (Claude ulanishiga ruxsat ekrani), u SPA'ga ketadi.
	@backend path /api/* /mcp /oauth/* /.well-known/* /healthz /readyz
	handle @backend {
		reverse_proxy backend:3000 {
			# STT + LLM bilan audio yuklash daqiqalar olishi mumkin.
			transport http {
				read_timeout 15m
				write_timeout 15m
			}
		}
	}

	# Vite bo'laklari (nomida xesh bor). Fayl yo'q bo'lsa — 404, index.html EMAS:
	# deploy'dan keyin ochiq oynadagi eski bo'lak so'ralganda HTML qaytsa,
	# brauzer uni JS deb yuklab "oq ekran" berardi (va 1 yilga keshlab qo'yardi).
	# Toza 404 ni frontend ushlaydi va sahifani bir marta yangilaydi.
	handle /assets/* {
		root * /srv
		@bor file
		header @bor Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		# index.html va SPA yo'llari keshlanmaydi — yangi deploy darhol ko'rinadi.
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}

# Asosiy sayt (landing, umumiy kirish, super admin). Domensiz rejimda
# kabinet subdomenlari ham shu yerga tushadi.
{$SITE_ADDRESS::80} {
	import ilova
}

# Mijoz kabinetlari HTTPS da (faqat domen bilan ishlatiladi).
https:// {
	tls {
		on_demand
	}
	import ilova
}
